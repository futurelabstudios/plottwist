# Paste your key into .env, never into frontend code. Restart npm run dev:full after edits.
OPENAI_API_KEY=
OPENAI_ENABLE_LIVE=true
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_DECISION_MODEL=gpt-6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_ENABLE_REALTIME=true
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-live-transcribe
OPENAI_ENABLE_IMAGES=true
OPENAI_IMAGE_MODEL=gpt-image-2
# Hosting: enable explicitly after adding server-scoped secrets and access/rate controls.
OPENAI_ALLOW_PUBLIC_LIVE=false
